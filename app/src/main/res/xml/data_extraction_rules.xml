<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules untuk API 31+.
   Kredensial API dikecualikan dari cloud backup dan device transfer karena terikat
   Android Keystore perangkat asal (lihat backup_rules.xml).
   Database Room (berisi isi notifikasi) dikecualikan dari cloud backup dan transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="api_credentials.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="api_credentials.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml"/>
    </device-transfer>
</data-extraction-rules>
