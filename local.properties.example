# Copy this file to `local.properties` (which is gitignored) and fill in the
# webhook configuration. These values are bundled into the APK at compile time
# via BuildConfig and cannot be changed by the end user at runtime.

## Android SDK location (auto-generated by Android Studio)
# sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

## Webhook URL — full HTTP/HTTPS endpoint where matched messages are forwarded.
WEBHOOK_URL=https://api.example.com/webhook

## HTTP method (POST recommended). Allowed: GET, POST, PUT, PATCH.
WEBHOOK_METHOD=POST

## Optional headers as a single-line JSON object. Use for auth tokens, API keys, etc.
## Escape inner quotes as you would in any properties file.
WEBHOOK_HEADERS_JSON={"Authorization":"Bearer your-token-here","X-Api-Key":"your-api-key"}
