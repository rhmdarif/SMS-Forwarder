# Copy this file to `local.properties` (which is gitignored) and fill in the
# webhook configuration. These values are bundled into the APK at compile time
# via BuildConfig and cannot be changed by the end user at runtime.

## Android SDK location (auto-generated by Android Studio)
# sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

## Webhook BASE URL. Endpoint final dibentuk saat runtime sebagai:
##   WEBHOOK_URL/{api_key}
## dengan api_key yang diinput user di aplikasi (layar setup / Pengaturan).
## api_secret milik user dikirim sebagai header `x-app-key`.
## Trailing slash boleh ada atau tidak; akan dinormalisasi.
WEBHOOK_URL=https://api-proxy.example.workers.dev/

## HTTP method (POST recommended). Allowed: GET, POST, PUT, PATCH.
WEBHOOK_METHOD=POST

## Optional extra headers as a single-line JSON object (dikirim bersama `x-app-key`).
## Escape inner quotes as you would in any properties file.
WEBHOOK_HEADERS_JSON={}

## URL kebijakan privasi publik (wajib untuk Google Play). Harus sama dengan URL yang
## didaftarkan di Play Console > App content > Privacy policy. Ditampilkan di layar
## Pengaturan dan di dialog disclosure sebelum izin SMS/notifikasi diminta.
PRIVACY_POLICY_URL=https://majopay.id/gateway/privacy
